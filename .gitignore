.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc

# 索引与运行产物
rag_storage/
logs/
logs_*.txt
*.log
.DS_Store
data/tmp/
q_test.txt
.pytest_cache/
ui_*.png
archive/

# 一次性的中间实验
data/*_k6.json
data/*_v1.json

# 消融逐题明细：只留生产那套，方便别人核对 README 里的表格
data/eval_*.json
data/eval_*.md
# 例外：README 里引用了这三个文件里的数字，不提交就没法核对。
# eval_prod.json = 124 题五组（第 2.1 节）
# eval_prod4.json = 316 题三组（第 2.2 节）
# eval_multiturn.json = 10 组两轮对话（第 16.1 节）
!data/eval_prod.json
!data/eval_prod4.json
!data/eval_multiturn.json
# 冷启动/热缓存与重复性检验的原始数据（README 2.1.1 的误差棒全靠它们可核对）
!data/eval_cold1.json
!data/eval_cold2.json
!data/eval_warm1.json
!data/eval_warm2.json

# 用户上传的文档（内容属于使用者，不进仓库；目录结构由 app/ingest.py 自己建）
data/uploads/
