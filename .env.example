# 复制为 .env 后填入自己的值
# 注意：.env 已在 .gitignore 里，不会被提交

# ---------- LLM（必填） ----------
# DeepSeek，deepseek-chat = 非思考模式。抽取实体必须用非思考模式，
# 思考模式会把 token 花在推理上，抽取质量反而下降，成本翻三倍。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-你的DeepSeekKey
LLM_MODEL=deepseek-chat

# 成本核算单价（元/百万 token，2026-11 DeepSeek 低峰价）
# 这两个数只影响"账单估算"，不影响实际扣费；留空就用默认值。
PRICE_IN_PER_M=1.07
PRICE_OUT_PER_M=4.29
# 注意：PRICE_QWEN_INPUT / PRICE_QWEN_OUTPUT / PRICE_QWEN_CACHED 三项已删除。
# 不是留空——留一个空配置项，迟早有人填个"差不多"的数进去，cost_cny 就悄悄失真了。

# ---------- 备用模型（默认关闭，不要随手打开） ----------
# 只有显式写 1 才会加载 qwen provider 并启用 failover；不写等于 0。
# 为什么默认关：引用编号越界会打穿"引用可回溯"这个核心承诺、免费额度不可预期、
# 两个模型混跑会污染 cost_cny。完整理由见 docs/DEPLOY.md「为什么默认不 failover」。
LLM_FALLBACK_ENABLED=0
# 下面三项只在 LLM_FALLBACK_ENABLED=1 时才被读取
# LLM_FALLBACK_MODEL=qwen-plus
# LLM_FALLBACK_BASE_URL=https://ws-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_FALLBACK_API_KEY=sk-ws-...
# LLM_FALLBACK_EXTRA_BODY={"enable_thinking": false}

# 主模型失败时的重试次数（含首次，默认 3 = 1 次 + 2 次重试，间隔 1s / 3s）。
# 评测跑批可以临时提到 5，长跑不该被几十秒的网络抖动毁掉。
# LLM_RETRIES=3

# ---------- Embedding ----------
# local = 本地 fastembed（0 费用、离线、CPU 10ms/条），推荐
# bailian = 阿里云百炼 text-embedding-v4（需开通模型权限，会产生少量费用）
EMBED_BACKEND=local
LOCAL_EMBED_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBED_DIM=512

# 仅在 EMBED_BACKEND=bailian 时需要
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ---------- 检索与重排 ----------
# 送进 cross-encoder 的最大字符数。
# 别为了降延迟把它调小：截到 160 时 40 题可答率从 95% 掉到 67.5%，
# 因为 chunk 开头往往只有小标题，区分两块内容的信息都在后面。完整复盘见 README 第 14 节。
RERANK_MAX_CHARS=512
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
# 每个实体/关系最多挂几个原文块。默认 5 会把 122 块的语料召回堆到 40+ 块，
# 压到 2 之后召回约 15 块，重排从 7s 降到 1.5s。
RELATED_CHUNK_NUMBER=2

# ---------- PDF 解析 ----------
# auto = 装了 docling 就用（表格结构更准），没装自动退回 PyMuPDF
# 强制指定可用 docling / pymupdf
PDF_BACKEND=auto

# ---------- 服务 ----------
# 索引用哪个目录（rag_storage/<TAG>）
TAG=prod
PORT=8000
